# RPG LLM Adventure — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- LLM Provider ---
# Ollama (local) — no API key needed, just ensure Ollama is running
# OLLAMA_URL=http://localhost:11434

# OpenAI API
# OPENAI_API_KEY=sk-your-key-here

# Anthropic API
# ANTHROPIC_API_KEY=your-key-here

# --- Server ---
# Host and port for the web server
# HOST=0.0.0.0
# PORT=8000

# --- Game Defaults ---
# DEFAULT_NARRATIVE_STYLE=épico e descritivo
# DEFAULT_ERA=fantasia medieval
# DEFAULT_CONTEXT=reino em guerra
# DEFAULT_PROTAGONIST=um jovem aventureiro
# DEFAULT_CHARACTERS=magos, guerreiros e criaturas místicas
# DEFAULT_ROUNDS=20
